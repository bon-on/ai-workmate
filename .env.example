TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
ALLOWED_USER_IDS=
DEFAULT_TELEGRAM_TARGET_CHAT_ID=
CODEX_WORKSPACE=/path/to/ai-workmate
ALLOWED_WORKSPACES=ai-workmate=/path/to/ai-workmate
PERSONAL_OPS_STATE_PATH=~/.codex/ai-workmate-personal-ops.json
EXTERNAL_STORAGE_PATH=/Volumes/CHANGE_ME
PHOTO_BACKUP_PATH=/Volumes/CHANGE_ME/iPhone-Originals
OPERATIONAL_MONITORING_ENABLED=true
# Daily read-only harness and publish-readiness checks of sibling repositories.
# REPO_CHECKS_ENABLED=true
# REPO_CHECK_HOUR=7
# REPO_CHECK_ROOT=/Users/you/sources
# HARNESS_LAB_CLI=/Users/you/sources/harness-lab/dist/index.js
# PUBLISH_CHECK_PRIVATE_TERMS=you@example.com,private-project-name
# launchd label used by /restart (inline-approved).
# AI_WORKMATE_LAUNCHD_LABEL=com.ai-workmate.bridge
DASHBOARD_HOST=127.0.0.1
# Extra host names allowed to reach the dashboard (loopback and *.ts.net are always allowed).
# DASHBOARD_ALLOWED_HOSTS=
DASHBOARD_PORT=8766
N8N_PORT=5678
TRADING_DASHBOARD_PORT=8000
# /tr runs in a sibling ../trading checkout unless this is set.
# TRADING_WORKSPACE_PATH=/path/to/trading
OLLAMA_PORT=11434
LOCAL_BRIEFING_MODEL=qwen3.5:latest
SCHEDULED_CODEX_MODEL=gpt-5.6-luna
SCHEDULED_CODEX_REASONING_EFFORT=none
# Primary engine: claude (default) or codex. Claude jobs fall back to Codex
# when Claude reports a rejected rate limit or a window reaches the threshold.
AI_PROVIDER=claude
# CLAUDE_BIN=claude
# CLAUDE_MODEL=
SCHEDULED_CLAUDE_MODEL=sonnet
SCHEDULED_CLAUDE_EFFORT=low
CLAUDE_FALLBACK_UTILIZATION=0.95
# Rate limits written by an interactive Claude Code statusline; fresher than the last bridge job.
# CLAUDE_RATE_LIMIT_SNAPSHOT=~/.claude/rate-limits.json
# Optional MCP servers for Claude operations modes (otherwise /n8n stays on Codex).
# CLAUDE_MCP_CONFIG=~/.config/ai-workmate/claude-mcp.json
TRANSCRIPTION_MODEL_PATH=/path/to/ai-workmate/models/ggml-base.bin
# Dashboard emoticon tab: sibling imoticon-maker checkout (default ../imoticon-maker) and its Python
IMOTICON_MAKER_PATH=
IMOTICON_PYTHON=python3
PERSONAL_BRIEFINGS_ENABLED=true
MORNING_BRIEF_TIME=08:00
EVENING_BRIEF_TIME=20:00
WEEKLY_REVIEW_TIME=20:30
AI_TREND_BRIEF_TIME=12:00
# Daily English news vocabulary (local Ollama, no Claude usage).
ENGLISH_STUDY_TIME=12:10
# ENGLISH_STUDY_ENABLED=false
PERSONAL_LOCATION=서울
WEATHER_LATITUDE=37.5665
WEATHER_LONGITUDE=126.9780
TELEGRAM_UNRESTRICTED_ENABLED=true
DENY_MODE=reply
